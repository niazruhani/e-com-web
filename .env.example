# Public storefront settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=BDT
NEXT_PUBLIC_LOCALE=en-BD

# Configure only in the server environment; never expose secrets with NEXT_PUBLIC_.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
CLIENT_IP_HEADER=

# Bangladesh delivery/tax policy. Amounts are integer paisa; tax is basis points.
DELIVERY_FEE_DHAKA_PAISE=
DELIVERY_FEE_OUTSIDE_DHAKA_PAISE=
FREE_DELIVERY_THRESHOLD_PAISE=
TAX_RATE_BPS=
SUPPORT_EMAIL=
SUPPORT_PHONE=
BUSINESS_POLICIES_CONFIRMED=

# Hosted SSLCommerz checkout. Use sandbox credentials until merchant approval.
SSLCOMMERZ_MODE=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# S3-compatible product image storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_PRODUCT_IMAGE_HOST=

# Resend transactional email adapter
EMAIL_API_KEY=
EMAIL_FROM=

# Protect scheduled reservation cleanup requests.
CRON_SECRET=
